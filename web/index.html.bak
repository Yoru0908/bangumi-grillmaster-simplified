<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kotoba Forge</title>
    <link rel="stylesheet" href="/static/styles.css">
  </head>
  <body>
    <main class="shell">
      <section class="hero" aria-labelledby="page-title">
        <div>
          <p class="eyebrow" data-i18n="heroEyebrow">Subtitle kiln control room</p>
          <h1 id="page-title">Kotoba Forge</h1>
          <p class="lede" data-i18n="heroLede">
            Submit a YouTube URL, watch each subtitle stage cook, then download the SRT artifacts.
          </p>
        </div>
        <div class="hero-tools">
          <label class="language-picker">
            <span data-i18n="languageLabel">Language</span>
            <select id="language-select" aria-label="Language">
              <option value="zh-Hans">简体中文</option>
              <option value="zh-Hant">繁體中文</option>
              <option value="en">English</option>
              <option value="ja">日本語</option>
            </select>
          </label>
          <div class="status-card" aria-live="polite">
            <span class="status-dot" id="health-dot"></span>
            <span id="health-text" data-i18n="healthChecking">Checking API...</span>
          </div>
        </div>
      </section>

      <section class="panel auth-panel" id="auth-panel" aria-labelledby="login-title">
        <div>
          <p class="eyebrow" data-i18n="inviteEyebrow">Invite access</p>
          <h2 id="login-title" data-i18n="loginTitle">Open the kitchen</h2>
        </div>
        <form id="login-form" class="form-grid">
          <label>
            <span data-i18n="emailLabel">Email</span>
            <input id="email" name="email" type="email" autocomplete="email" required>
          </label>
          <label>
            <span data-i18n="inviteCodeLabel">Invite code</span>
            <input id="invite-code" name="invite_code" type="password" autocomplete="one-time-code" required>
          </label>
          <button type="submit" data-i18n="loginButton">Login</button>
        </form>
      </section>

      <section class="workspace is-hidden" id="workspace" aria-label="SaaS workspace">
        <div class="workspace-rail">
        <aside class="panel account-panel">
          <p class="eyebrow" data-i18n="operatorEyebrow">Operator</p>
          <h2 id="user-email" data-i18n="notSignedIn">Not signed in</h2>
          <p class="balance"><span id="balance-minutes">0</span> <span data-i18n="minutesLeft">minutes left</span></p>
          <button id="logout-button" type="button" class="ghost" data-i18n="logoutButton">Logout</button>
        </aside>

        <section class="panel billing-panel" id="billing-panel" aria-labelledby="top-up-title">
          <div>
            <p class="eyebrow" data-i18n="billingEyebrow">Billing</p>
            <h2 id="top-up-title" data-i18n="topUpTitle">Top up credits</h2>
            <p class="panel-copy" data-i18n="topUpCopy">Phase 1 uses manual top-up. Send the operator your account email and desired minutes; credits appear here after admin approval.</p>
          </div>
          <div class="pricing-grid">
            <article>
              <strong data-i18n="starterPackTitle">Starter</strong>
              <span data-i18n="starterPackCopy">30 min for smoke tests</span>
            </article>
            <article>
              <strong data-i18n="studioPackTitle">Studio</strong>
              <span data-i18n="studioPackCopy">120 min for regular uploads</span>
            </article>
            <article>
              <strong data-i18n="archivePackTitle">Archive</strong>
              <span data-i18n="archivePackCopy">600 min for batch work</span>
            </article>
          </div>
        </section>

        <section class="panel jobs-panel" aria-labelledby="jobs-title">
          <div class="panel-head">
            <div>
              <p class="eyebrow" data-i18n="queueEyebrow">Queue</p>
              <h2 id="jobs-title" data-i18n="jobsTitle">Jobs</h2>
            </div>
            <button id="refresh-button" type="button" class="ghost" data-i18n="refreshButton">Refresh</button>
          </div>
          <div id="job-list" class="job-list" aria-live="polite"></div>
        </section>
        </div>

        <div class="workspace-main">
        <section class="panel playground-panel" id="playground-panel" aria-labelledby="playground-title">
          <div>
            <p class="eyebrow" data-i18n="playgroundEyebrow">Playground</p>
            <h2 id="playground-title" data-i18n="playgroundTitle">Try a short clip first</h2>
            <p class="panel-copy" data-i18n="playgroundCopy">Free trial lane for short videos. Use it to confirm subtitles and downloads before spending credits.</p>
          </div>
          <form id="playground-form" class="submit-form">
            <label>
              <span data-i18n="sourceUrlLabel">YouTube URL</span>
              <input id="playground-source-url" name="source_url" type="url" placeholder="https://www.youtube.com/watch?v=..." data-i18n-placeholder="sourceUrlPlaceholder" required>
            </label>
            <button type="submit" data-i18n="trialButton">Start playground job</button>
          </form>
        </section>

        <section class="panel paid-workspace-panel" id="paid-workspace-panel" aria-labelledby="paid-workspace-title">
          <div>
            <p class="eyebrow" data-i18n="paidWorkspaceEyebrow">Paid workspace</p>
            <h2 id="paid-workspace-title" data-i18n="paidWorkspaceTitle">Process the full video</h2>
            <p class="panel-copy" data-i18n="paidWorkspaceCopy">Use credits for real jobs with full pipeline processing and downloadable SRT files.</p>
          </div>
          <form id="paid-job-form" class="submit-form">
            <label>
              <span data-i18n="sourceUrlLabel">YouTube URL</span>
              <input id="paid-source-url" name="source_url" type="url" placeholder="https://www.youtube.com/watch?v=..." data-i18n-placeholder="sourceUrlPlaceholder" required>
            </label>
            <p id="paid-status-message" class="provider-warning is-hidden" aria-live="polite"></p>
            <button type="submit" class="primary" data-i18n="paidButton">Use credits</button>
          </form>
        </section>

        <section class="panel detail-panel" aria-labelledby="detail-title">
          <div>
            <p class="eyebrow" data-i18n="currentRoastEyebrow">Current roast</p>
            <h2 id="detail-title" data-i18n="detailTitle">Job detail</h2>
          </div>
          <div id="job-detail" class="empty-state" data-i18n="selectJobEmpty">Select a job to inspect stages and downloads.</div>
          <div id="download-links" class="downloads"></div>
          <ol id="event-list" class="event-list" aria-live="polite"></ol>
        </section>

        <section class="panel admin-panel is-hidden" id="admin-panel" aria-labelledby="admin-title">
          <div class="panel-head">
            <div>
              <p class="eyebrow" data-i18n="adminEyebrow">Admin console</p>
              <h2 id="admin-title" data-i18n="adminTitle">Back office heat check</h2>
            </div>
            <button id="admin-refresh-button" type="button" class="ghost" data-i18n="adminRefreshButton">Refresh admin</button>
          </div>
          <div class="admin-grid">
            <section aria-labelledby="admin-users-title">
              <h3 id="admin-users-title" data-i18n="usersBalancesTitle">Users &amp; balances</h3>
              <div id="admin-user-list" class="admin-list" aria-live="polite"></div>
            </section>
            <section aria-labelledby="admin-jobs-title">
              <h3 id="admin-jobs-title" data-i18n="allJobsTitle">All jobs</h3>
              <div id="admin-job-list" class="admin-list" aria-live="polite"></div>
            </section>
            <section aria-labelledby="credit-adjust-title">
              <h3 id="credit-adjust-title" data-i18n="adjustCreditsTitle">Adjust credits</h3>
              <form id="credit-adjust-form" class="form-grid">
                <label>
                  <span data-i18n="targetUserIdLabel">Target user id</span>
                  <input id="credit-user-id" name="user_id" required>
                </label>
                <label>
                  <span data-i18n="minutesLabel">Minutes</span>
                  <input id="credit-minutes" name="minutes" type="number" step="0.1" required>
                </label>
                <label>
                  <span data-i18n="reasonLabel">Reason</span>
                  <input id="credit-reason" name="reason" required>
                </label>
                <button type="submit" data-i18n="applyCreditButton">Apply credit change</button>
              </form>
            </section>
            <section aria-labelledby="audit-title">
              <h3 id="audit-title" data-i18n="auditLogsTitle">Audit logs</h3>
              <ol id="audit-log-list" class="event-list" aria-live="polite"></ol>
            </section>
          </div>
        </section>
        </div>
      </section>

      <div id="toast" class="toast" role="status" aria-live="polite"></div>
    </main>
    <script src="/static/app.js" defer></script>
  </body>
</html>
